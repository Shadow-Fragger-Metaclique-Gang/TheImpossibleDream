// Code used to make this NOT BREAK EVERYONE'S renamed species & saved characters

// This code overwrites some of the proc in preferences_savefile.dm without using the weird savefile version 3X thing that the code asks for any updated prefs.
/datum/preferences/_load_species(S, species_name = null)
	if(!species_name)
		S["species"] >> species_name
	if(species_name && !GLOB.species_list[species_name])
		var/datum/species/legacy_type = GLOB.species_legacy_names[species_name]
		if(legacy_type)
			species_name = initial(legacy_type.name)
	return ..(S, species_name)

/// List of species names from other servers - or older saves. With any luck, this won't break fucking everything this time. If anyone wants to change the name of species from here, add that old name to this chart!!
GLOBAL_LIST_INIT(species_legacy_names, list(
	"Sissean" = /datum/species/lizardfolk,
	"Zardman" = /datum/species/lizardfolk,
	"Vulpkian" = /datum/species/vulpkanin,
	"Half Orc" = /datum/species/halforc,
	"Half-Kin" = /datum/species/demihuman,
	"Wild-Kin" = /datum/species/anthromorph,
))
