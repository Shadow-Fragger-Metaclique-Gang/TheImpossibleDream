/obj/structure/fluff/psycross
	name = "stone pantheon wheel"
	desc = "Symbol of the Divine Pantheon, the religion of five - once ten, and nevermore - deities which reigns throughout most of the known world. Their divine order must be maintained."

/obj/structure/fluff/psycross/copper
	name = "pantheonic wheel"

/obj/structure/fluff/psycross/crafted
	name = "wooden pantheonic wheel"

/obj/structure/fluff/psycross/psycrucifix/stone
	desc = "Formed of stone, this great Psycross symbolises that HE is forever ENDURING."

/obj/structure/roguewindow/stained/silver
	desc = "A stained glass window bearing the cross of Psydon, the Allfather, God-made-Man, the Agonist Eternal, and the Greatest Flame. \
	Either as a venerated martyr or a still-living deity, His imagery features often in both temples of the Great Gods \
	and those across every Psydonian house of worship across the world. Despite their differences, they share a common origin."

/obj/structure/roguewindow/stained/yellow
	desc = "A stained glass window bearing the symbolism of Astrata, the Tyrant Star that reigns over the Divine \
	Pantheon of the Pentacle. Her uniquely vaunted position earns her symbol's common usage in all officiated, whereas \
	she is reduced to the status of a Fragment by the Orthodoxy - and a tyrant by the other branches. Worse, still, is her view by the Ascendant."

/obj/structure/roguewindow/stained/zizo
	name = "ascendant stained glass window"
	desc = "A stained glass window bearing an inverted cross of Psydon, usually used as a symbol of the Demiurge, Zizo, \
	Regent of Ambition, Harbinger of Undeath, and a deity condemned in almost every realm of across the Known World. All the same, Her followers \
	construct such intricate things in Her honor, even knowing that they may so soon be shattered. <b><i>Zaos Dei.</b></i>"

/obj/structure/fluff/walldeco/psybanner
	desc = "A banner of fine fabric bearing the symbol of Psydon, the Shattered God, creator of the world. \
	Flown frequently by both Psydonian and Pantheonic authorities - though the latter far less.</br>By toggling the 'Mechanics' tab, I can learn much more about this poster's given topic."

/obj/structure/fluff/walldeco/psybanner/tennite
	name = " pantheonic banner"
	desc = "A banner depicting a circle over a cross; the symbolic wheel of of the Temple of the Pentacle, the sphere of \
	Midderland religious practice dedicated to the entirety of the Greatest Divine Wills without favour or preference."

/obj/structure/fluff/walldeco/psybanner/astrata
	desc = "The six-pronged cross of Astrata, embroidered upon fine fabric. It is Her will that \
	suspends the heavens and the earth, and it is Her light that maintains life upon the abandoned \
	surface of Psydonia. An image associated with the nobility of all lands, and with the \
	highest echelons of temple leadership."

/obj/structure/fluff/walldeco/psybanner/zizo
	desc = "A carefully made banner bearing the inverted cross of Zizo, the Anathema Anatheme. Banners such \
	as this one are wildly dangerous to fly in any Tennite or Psydonite nation, in which the worship \
	of the progenitor of undeath is harshly criminalised, but may be commonly found in more remote \
	areas of the world."

/obj/structure/fluff/walldeco/customflag
	name = "Flag of the Pharos"
	desc = "A banner flutters in the breeze in the proud heraldic colors of the County."
